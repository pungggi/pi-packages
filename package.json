{
  "name": "pi-packages",
  "version": "0.0.0",
  "description": "In-TUI package manager for pi. Adds /packages that lists every configured package with version numbers, detects available updates on demand, and installs / updates / removes packages by orchestrating the pi CLI.",
  "keywords": [
    "pi-package",
    "pi",
    "pi.dev",
    "pi-extension",
    "packages",
    "package-manager",
    "install",
    "update",
    "npm",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pungggi/pi-packages.git"
  },
  "homepage": "https://github.com/pungggi/pi-packages#readme",
  "bugs": {
    "url": "https://github.com/pungggi/pi-packages/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": ">=0.83.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@earendil-works/pi-tui": ">=0.83.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "publishConfig": {
    "access": "public"
  }
}
